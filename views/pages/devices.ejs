<% layout('main') -%>


<div class="main_layout">
  <header class="main_header">
      <h1>Devices</h1>
      <button id="add-device-btn" class="btn main_btn add-new">Add Device</button>
  </header>

  <div class="main_wrapper">
    <main class="main_content">
      <table>
        <thead>
          <tr>
            <th>DEVICE</th>
            <th>IP</th>
            <th>STATUS</th>
            <th>UPTIME</th>
            <th>MODEL</th>
            <th>VERSION</th>
            <th>ACTIONS</th>
          </tr>
        </thead>
        <tbody id="devices-tbody">
          <!-- ./devices.js -->
        </tbody>
      </table>
    </main>

    <aside style="display: none;" id="context-menu" class="context-menu">
      <h1 id="device_aside_title">Device Name</h1>
      
      <h2>--- WiFi ---</h2>
      <table id="wifi-status">
        <!-- tbody from ./devices.js -->
      </table>

      <h2>--- Device ---</h2>
      <table id="device-status">
        <!-- tbody from ./devices.js -->
      </table>
      
      <button id="remove_device_btn" class="btn">Remove device</button>
    </aside>
  </div>

  <div class="modal-wrapper" id="add-device-modal" style="z-index: -1;">
  <div class="modal card">
    <h2>Add Device</h2>
    
    <form id="add-device-form">
      <div class="form-group">
        <label for="device-ip">IP Address</label>
        <input type="text" id="device-ip" name="ip" placeholder="192.168.1.10" required>
      </div>

      <div class="form-group">
        <label for="device-nick">Device Name</label>
        <input type="text" id="device-nick" name="nick" placeholder="AP Room" required>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn modal--btn">Add Device</button>
        <button type="button" class="btn modal--btn" onclick="closeModal()">Cancel</button>
      </div>
    </form>

  </div>
</div>
</div>


<script src="/scripts/pages/devices.js"></script>
<script>
  loadTable()
</script>