<% layout('main') -%>


  <div class="main_layout">
    <header class="main_header">
      <h1>Dashboard</h1>
    </header>

    <main class="main_content">

      <div class="cards__row"> <!-- Fila 1 -->
        <div class="card">
          <h2 class="card__title">Internet</h2>
          <h3 class="card__status status--online">[Online]</h3>
          <p class="card__metric">Public IP: 192.168.1.1</p>
          <p class="card__metric">Latency: 10ms</p>
          <p class="card__metric">Download: 150Mbps</p>
          <p class="card__metric">Upload: 50Mbps</p>
        </div>

        <div class="card">
          <h2 class="card__title">Devices</h2>
          <h3 class="card__status status--online">[All Working]</h3>
          <p class="card__metric">APs: 3</p>
          <p class="card__metric">Switches: 2</p>
          <p class="card__metric">Gateways: 1</p>
        </div>

        <div class="card">
          <h2 class="card__title">Clients</h2>
          <h3 class="card__status status--online">[Optimal Experience]</h3>
          <p class="card__metric">Wireless: 30</p>
          <p class="card__metric">Wired: 15</p>
        </div>
      </div>

      <div class="cards__row"> <!-- Fila 2 -->
        <div class="card card--throughput" id="throughput">
          <h2 class="card__title">Throughput</h2>
          <div class="card__throughput-placeholder">
            placeholder
          </div>
        </div>

        <div class="card card--alerts" id="alerts">
          <h2 class="card__title">Recent Alerts</h2>
          <div class="card__alert-item">
            <span class="card__alert-text">Update available for &lt;device&gt;</span>
            <span class="card__alert-time">2 minutes ago</span>
          </div>
          <div class="card__alert-item">
            <span class="card__alert-text">High CPU usage on &lt;gateway&gt;</span>
            <span class="card__alert-time">12 minutes ago</span>
          </div>
          <div class="card__alert-item">
            <span class="card__alert-text">Internet connection restored</span>
            <span class="card__alert-time">14 minutes ago</span>
          </div>
          <div class="card__alert-item">
            <span class="card__alert-text">New login from 192.168.5.23</span>
            <span class="card__alert-time">20 minutes ago</span>
          </div>
          <div class="card__alert-item">
            <span class="card__alert-text">Internet connection lost</span>
            <span class="card__alert-time">25 minutes ago</span>
          </div>
        </div>
      </div>

    </main>
  </div>